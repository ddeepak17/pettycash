# Copy to .env.local and fill in. Nothing here is a secret; the values you add are.

# Which chain. mainnet-beta means real USDC.
CLUSTER=mainnet-beta

# Solana RPC endpoints, comma separated, in order of preference. Reads fail over; sends go to all.
RPC_URLS=https://api.mainnet-beta.solana.com,https://api.mainnet.solana.com

# The agent's key as a 64-byte JSON array (solana-keygen format). It is the only key allowed to pull from a petty cash.
AGENT_SECRET_KEY=

# Postgres connection string for a login that can reach only the pettycash schema (see scripts/db-setup.ts).
DATABASE_URL=

# Any long random string. Signs the sign-in challenge and the session cookie.
SESSION_SECRET=

# QuickNode Streams: API key, the stream's id and its webhook security token (scripts/stream.ts create writes the last two).
QUICKNODE_API_KEY=
QN_STREAM_ID=
QN_STREAM_SECURITY_TOKEN=

# Optional: the public demo petty cash (owner wallet and allowance account). Leave empty to switch the demo off.
HOUSE_OWNER=
HOUSE_DELEGATION=

# Optional: shared secret for GET /api/cron/tick (housekeeping).
CRON_SECRET=

# Optional tuning. Amounts are USDC base units (1000000 = $1).
# REASONING_MODEL=anthropic/claude-haiku-4.5
# HOUSE_REASONING_MODEL=google/gemini-3-flash-preview
# PER_PURCHASE_MAX_BASE=50000
# APPROVAL_THRESHOLD_BASE=10000
# RUN_BUDGET_BASE=250000
# HOUSE_RUN_BUDGET_BASE=30000
# HOUSE_RUNS_PER_HOUR_PER_IP=40
# HOUSE_RUNS_PER_HOUR=150
# PRIORITY_MICROLAMPORTS=2000
# STREAM_IDLE_MINUTES=2
